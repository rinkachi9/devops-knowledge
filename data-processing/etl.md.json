    {
      "term": "ETL",
      "anchor": "#the-three-steps",
      "definition": "Extract, transform, load: moving data from sources through cleaning and reshaping into a target such as a warehouse."
    },
    {
      "term": "ELT",
      "anchor": "#etl-compared-with-elt",
      "definition": "Loading raw data into the warehouse first and transforming it there."
    },
    {
      "term": "Idempotent load",
      "anchor": "#operating-pipelines-as-a-devops-practice",
      "definition": "A load that gives the same result when rerun for the same input."
