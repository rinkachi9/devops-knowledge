  "concepts": [
    {
      "term": "Continuous integration",
      "anchor": "#definitions",
      "definition": "Integrating code into a shared branch frequently, with every integration verified by an automated build and tests."
    },
    {
      "term": "Continuous delivery",
      "anchor": "#definitions",
      "definition": "Keeping every validated change releasable and delivered to a repository or staging, with a manual decision for production."
    },
    {
      "term": "Continuous deployment",
      "anchor": "#definitions",
      "definition": "Deploying every change that passes the pipeline to production automatically."
    },
    {
      "term": "Build once, deploy many",
      "anchor": "#core-principles",
      "definition": "Promoting the same tested artifact through all environments instead of rebuilding it."
    }
  ],
