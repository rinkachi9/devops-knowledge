  "concepts": [
    {
      "term": "Psychological safety",
      "anchor": "#psychological-safety",
      "definition": "A shared belief that the team is safe for interpersonal risk taking."
    },
    {
      "term": "Generative culture",
      "anchor": "#westrums-typology-of-organizational-cultures",
      "definition": "A performance-oriented culture in which information flows freely and failure leads to inquiry."
    },
    {
      "term": "Just culture",
      "anchor": "#just-culture",
      "definition": "An approach that responds differently to human error, at-risk behavior and reckless behavior."
    },
    {
      "term": "Blameless postmortem",
      "anchor": "#blameless-postmortems",
      "definition": "An incident review that seeks systemic causes and improvements instead of a culprit."
    },
    {
      "term": "Hindsight bias",
      "anchor": "#blameless-postmortems",
      "definition": "Seeing past events as more predictable than they were when they happened."
    }
