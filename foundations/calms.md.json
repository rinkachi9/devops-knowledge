      "term": "CALMS",
      "anchor": "#origin-and-purpose",
      "definition": "A framework describing DevOps through Culture, Automation, Lean, Measurement and Sharing."
    },
    {
      "term": "Little's law",
      "anchor": "#lean",
      "definition": "Average lead time equals work in progress divided by throughput."
    },
    {
      "term": "Goodhart's law",
      "anchor": "#measurement",
      "definition": "When a measure becomes a target, it ceases to be a good measure."
