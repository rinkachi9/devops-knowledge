    },
    {
      "term": "Percent complete and accurate",
      "anchor": "#key-terms-and-metrics",
      "definition": "Share of a step's output the next step can use without correction."
    },
    {
      "term": "Activity ratio",
      "anchor": "#key-terms-and-metrics",
      "definition": "Total process time divided by total lead time, also called flow efficiency."
