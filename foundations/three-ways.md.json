  "concepts": [
    {
      "term": "First Way",
      "anchor": "#the-first-way-flow",
      "definition": "Fast flow of work from development to operations to the customer, optimized for the whole system."
    },
    {
      "term": "Second Way",
      "anchor": "#the-second-way-feedback",
      "definition": "Fast, constant feedback from right to left so problems are fixed at the source."
    },
    {
      "term": "Third Way",
      "anchor": "#the-third-way-continual-learning-and-experimentation",
      "definition": "A culture of experimentation and learning from both success and failure."
    },
    {
      "term": "Constraint",
      "anchor": "#the-first-way-flow",
      "definition": "The slowest stage of a value stream, which limits the throughput of the whole system."
    }
  ],
