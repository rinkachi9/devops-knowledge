  "concepts": [
    {
      "term": "Change lead time",
      "anchor": "#the-five-metrics",
      "definition": "Time from a commit to the change running successfully in production."
    },
    {
      "term": "Deployment frequency",
      "anchor": "#the-five-metrics",
      "definition": "How often changes are deployed to production."
    },
    {
      "term": "Failed deployment recovery time",
      "anchor": "#the-five-metrics",
      "definition": "Time to recover from a deployment that fails and needs immediate intervention."
    },
    {
      "term": "Change fail rate",
      "anchor": "#the-five-metrics",
      "definition": "Share of deployments that need immediate intervention such as a rollback or hotfix."
    },
    {
      "term": "Deployment rework rate",
      "anchor": "#the-five-metrics",
      "definition": "Share of deployments that are unplanned fixes for production incidents."
    },
    {
      "term": "Capability model",
      "anchor": "#capabilities",
      "definition": "An improvement approach that links research-backed capabilities to outcomes instead of fixed levels."
    },
    {
      "term": "J-curve",
      "anchor": "#the-j-curve-and-other-findings-worth-knowing",
      "definition": "The temporary drop in performance at the start of a transformation before improvement."
    }
  ],
