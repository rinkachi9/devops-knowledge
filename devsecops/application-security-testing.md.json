      "term": "SAST",
      "anchor": "#sast-static-application-security-testing",
      "definition": "Static analysis of source code for insecure patterns without running it."
    },
    {
      "term": "SCA",
      "anchor": "#sca-software-composition-analysis",
      "definition": "Inventory of third-party components matched against vulnerability and license data."
    },
    {
      "term": "DAST",
      "anchor": "#dast-dynamic-application-security-testing",
      "definition": "Testing a running application from the outside with crafted requests."
    },
    {
      "term": "Taint analysis",
      "anchor": "#sast-static-application-security-testing",
      "definition": "Tracking untrusted input from a source to a dangerous sink without a sanitizer."
    },
