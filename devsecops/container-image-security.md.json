  "concepts": [
    {
      "term": "Base image",
      "anchor": "#choosing-a-base-image",
      "definition": "The image a container image is built on, which brings its OS packages and vulnerabilities."
    },
    {
      "term": "Distroless image",
      "anchor": "#choosing-a-base-image",
      "definition": "A minimal image with only the application runtime and no shell or package manager."
    },
    {
      "term": "Multi-stage build",
      "anchor": "#building-securely",
      "definition": "A Dockerfile with separate build and runtime stages so build tools stay out of the final image."
    }
