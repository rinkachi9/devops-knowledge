  "concepts": [
    {
      "term": "USE method",
      "anchor": "#definitions",
      "definition": "A checklist that examines the utilization, saturation and errors of every resource."
    },
    {
      "term": "Utilization",
      "anchor": "#definitions",
      "definition": "The share of time a resource was busy, or the share of its capacity in use."
    },
    {
      "term": "Saturation",
      "anchor": "#definitions",
      "definition": "The amount of extra work a resource cannot service yet, usually queued."
    },
    {
      "term": "Anti-method",
      "anchor": "#the-problem-the-method-solves",
      "definition": "A habitual but unreliable way of investigating performance, such as the streetlight anti-method."
    },
    {
      "term": "Pressure stall information",
      "anchor": "#linux-checklist",
      "definition": "Linux metrics of the share of time tasks were stalled waiting for CPU, memory or I/O."
    }
  ],
