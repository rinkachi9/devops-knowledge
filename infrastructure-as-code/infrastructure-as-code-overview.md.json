  "concepts": [
    {
      "term": "Infrastructure as code",
      "anchor": "#summary",
      "definition": "Managing and provisioning infrastructure through machine-readable definition files kept in version control."
    },
    {
      "term": "Idempotency",
      "anchor": "#key-concepts",
      "definition": "Applying the same definition many times gives the same result as applying it once."
    },
    {
      "term": "Configuration drift",
      "anchor": "#key-concepts",
      "definition": "The difference between the declared state and the real state of infrastructure."
    },
    {
      "term": "Declarative approach",
      "anchor": "#key-concepts",
      "definition": "Defining what the end state should be and letting the tool compute the steps."
    }
  ],
