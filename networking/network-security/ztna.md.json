  "concepts": [
    {
      "term": "Zero trust",
      "anchor": "#definition",
      "definition": "A security model in which no access is trusted by network location and every request is verified."
    },
    {
      "term": "ZTNA",
      "anchor": "#definition",
      "definition": "Per-application access through identity-aware gateways instead of network-level VPN access."
    },
    {
      "term": "Microsegmentation",
      "anchor": "#microsegmentation",
      "definition": "Segmentation down to individual workloads that restricts east-west traffic."
    }
