  "concepts": [
    {
      "term": "Domain control validation",
      "anchor": "#domain-control-validation",
      "definition": "The CA's check that the requester controls each name in a certificate."
    },
    {
      "term": "CAA record",
      "anchor": "#dns-records-that-matter-for-certificates",
      "definition": "A DNS record listing which CAs may issue certificates for a domain."
    },
    {
      "term": "CAA tree climbing",
      "anchor": "#dns-records-that-matter-for-certificates",
      "definition": "The CA's search for CAA from the requested name up toward the root, stopping at the first record set."
    },
    {
      "term": "Certificate Transparency",
      "anchor": "#certificate-transparency",
      "definition": "Public append-only logs of every publicly trusted certificate."
    },
    {
      "term": "SCT",
      "anchor": "#certificate-transparency",
      "definition": "A signed certificate timestamp proving a certificate was submitted to a CT log."
    },
    {
      "term": "TLSA record",
      "anchor": "#dns-records-that-matter-for-certificates",
      "definition": "A DNSSEC-protected record that pins the certificate or key a service must present."
    }
  ],
