  "concepts": [
    {
      "term": "DMZ",
      "anchor": "#definition-and-goal",
      "definition": "A separate network segment for internet-facing services between the Internet and the internal network."
    },
    {
      "term": "Dual firewall DMZ",
      "anchor": "#architecture-models",
      "definition": "A DMZ between an outer and an inner firewall so traffic is filtered twice."
    },
    {
      "term": "Egress filtering",
      "anchor": "#security-mechanisms",
      "definition": "Restricting outbound traffic from a zone to only required destinations."
    }
