  "concepts": [
    {
      "term": "VPN",
      "anchor": "#definition-and-functions",
      "definition": "An encrypted tunnel over an untrusted network that makes remote devices or networks appear directly connected."
    },
    {
      "term": "Encapsulation",
      "anchor": "#how-it-works",
      "definition": "Wrapping an encrypted original packet inside a new packet addressed to the VPN gateway."
    },
    {
      "term": "Kill switch",
      "anchor": "#security-considerations",
      "definition": "Firewall rules that block all traffic outside the tunnel if the VPN drops."
    }
