  "concepts": [
    {
      "term": "ACME",
      "anchor": "#the-problem-acme-solves",
      "definition": "A protocol that automates obtaining, renewing and revoking certificates from a CA."
    },
    {
      "term": "Order",
      "anchor": "#actors-and-resources",
      "definition": "An ACME request for a certificate covering a set of identifiers."
    },
    {
      "term": "Challenge",
      "anchor": "#challenge-types",
      "definition": "A task that proves control of an identifier, such as http-01, dns-01 or tls-alpn-01."
    },
    {
      "term": "Key authorization",
      "anchor": "#challenge-types",
      "definition": "The challenge token joined with the account key thumbprint, which binds a proof to the account."
    },
    {
      "term": "ARI",
      "anchor": "#renewal-revocation-and-account-management",
      "definition": "An ACME extension in which the CA suggests a renewal window for each certificate."
    },
    {
      "term": "External Account Binding",
      "anchor": "#extensions-and-related-specifications",
      "definition": "A MAC-based link between an ACME account and an existing customer account at a CA."
    }
  ],
