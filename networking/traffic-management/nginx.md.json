    {
      "term": "Master process",
      "anchor": "#process-model",
      "definition": "The privileged nginx process that reads configuration, binds ports and supervises workers."
    },
    {
      "term": "Worker process",
      "anchor": "#process-model",
      "definition": "A single-threaded nginx process that handles many connections with a non-blocking event loop."
    },
    {
      "term": "Graceful reload",
      "anchor": "#configuration-updates-without-downtime",
      "definition": "Replacing workers with new configuration while old ones finish current requests."
