  "concepts": [
    {
      "term": "CDN",
      "anchor": "#definition",
      "definition": "A globally distributed network of caching proxies that serve content close to users."
    },
    {
      "term": "Pull CDN",
      "anchor": "#push-and-pull-cdns",
      "definition": "A CDN that fetches content from the origin on the first request and caches it for its TTL."
    },
    {
      "term": "Cache hit ratio",
      "anchor": "#worked-example",
      "definition": "The share of requests served from cache without contacting the origin."
    }
