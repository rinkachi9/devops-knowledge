      "term": "Recursive resolver",
      "anchor": "#types-of-dns-service",
      "definition": "A DNS server that resolves names on behalf of clients and caches the answers."
    },
    {
      "term": "Authoritative nameserver",
      "anchor": "#types-of-dns-service",
      "definition": "A DNS server that holds a zone's records and gives final answers."
    },
