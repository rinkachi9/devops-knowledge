    {
      "term": "SPF",
      "anchor": "#definition-and-importance",
      "definition": "A DNS policy listing the servers allowed to send mail for a domain's envelope sender."
    },
    {
      "term": "SPF qualifier",
      "anchor": "#mechanisms-and-qualifiers",
      "definition": "The prefix of a mechanism that sets the result: pass, fail, softfail or neutral."
    },
    {
      "term": "Ten-lookup limit",
      "anchor": "#limitations-and-workarounds",
      "definition": "SPF evaluation may use at most 10 DNS lookups before a permanent error."
