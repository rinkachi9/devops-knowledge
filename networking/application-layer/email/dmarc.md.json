    {
      "term": "DMARC",
      "anchor": "#definition",
      "definition": "A policy and reporting framework that requires SPF or DKIM to pass in alignment with the From domain."
    },
    {
      "term": "Identifier alignment",
      "anchor": "#alignment",
      "definition": "Matching the SPF or DKIM authenticated domain with the visible From domain."
    },
