  "concepts": [
    {
      "term": "Operating system",
      "anchor": "#definition-and-function",
      "definition": "System software that manages hardware resources and provides an environment for programs, acting as an interface between user and hardware."
    },
    {
      "term": "Kernel",
      "anchor": "#definition-and-function",
      "definition": "The core of the OS that runs in privileged mode and provides services through system calls."
    },
    {
      "term": "Multiprogramming",
      "anchor": "#multiprogramming-operating-system",
      "definition": "Keeping several programs in memory so the CPU runs another while one waits for I/O."
    },
    {
      "term": "Real-time operating system",
      "anchor": "#real-time-operating-system",
      "definition": "An OS that guarantees tasks complete within deadlines."
    }
  ],
