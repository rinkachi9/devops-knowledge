  "concepts": [
    {
      "term": "Process monitoring",
      "anchor": "#summary",
      "definition": "Tracking processes and their resource use to detect bottlenecks, misbehavior and failures."
    },
    {
      "term": "Stealth process",
      "anchor": "#process-related-issues",
      "definition": "A malicious process hidden from normal monitoring tools, often by a rootkit."
    },
    {
      "term": "Resource contention",
      "anchor": "#process-related-issues",
      "definition": "Several processes competing for the same CPU, memory or I/O, degrading performance."
    }
  ],
