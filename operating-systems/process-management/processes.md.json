  "concepts": [
    {
      "term": "Process",
      "anchor": "#definition",
      "definition": "A program in execution with its own memory, state and resources, identified by a PID."
    },
    {
      "term": "Daemon",
      "anchor": "#types-of-processes",
      "definition": "A background process started at boot that runs as a service."
    },
    {
      "term": "Zombie process",
      "anchor": "#process-states",
      "definition": "A terminated process whose exit status has not yet been collected by its parent."
    },
    {
      "term": "Signal",
      "anchor": "#signals",
      "definition": "An asynchronous notification delivered to a process by the kernel."
    },
    {
      "term": "Nice value",
      "anchor": "#process-priority-and-nice-values",
      "definition": "A scheduling weight from -20 (highest priority) to 19 (lowest)."
    }
