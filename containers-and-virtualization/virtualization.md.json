  "concepts": [
    {
      "term": "Hypervisor",
      "anchor": "#terminology",
      "definition": "Software that creates and runs virtual machines and allocates physical resources to them."
    },
    {
      "term": "Type 1 hypervisor",
      "anchor": "#hypervisor-types",
      "definition": "A hypervisor that runs directly on the hardware without a host operating system."
    },
    {
      "term": "Type 2 hypervisor",
      "anchor": "#hypervisor-types",
      "definition": "A hypervisor that runs as an application on a host operating system."
    },
    {
      "term": "Hardware-assisted virtualization",
      "anchor": "#how-a-hypervisor-works",
      "definition": "CPU extensions such as Intel VT-x and AMD-V that let guest kernels run directly on the CPU."
    }
